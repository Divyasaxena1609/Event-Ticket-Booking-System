# Copy to the repository-root .env or set these in your environment.
# Replace every placeholder locally; never commit real credentials.
BOOKING_DB_PASSWORD=replace-with-a-strong-local-database-password
RAZORPAY_KEY_ID=your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

BOOKING_DB_URL=jdbc:postgresql://postgres:5432/booking_db
BOOKING_DB_USERNAME=postgres
REDIS_HOST=redis
REDIS_PORT=6379
