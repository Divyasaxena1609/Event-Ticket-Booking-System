# Copy to .env in the repository root. Never commit .env or real credentials.
# Generate unique strong passwords for each local database.
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=replace-with-a-strong-auth-db-password
USER_DB_USERNAME=user_postgres
USER_DB_PASSWORD=replace-with-a-strong-user-db-password
EVENT_DB_USERNAME=event_user
EVENT_DB_PASSWORD=replace-with-a-strong-event-db-password
BOOKING_DB_USERNAME=booking_user
BOOKING_DB_PASSWORD=replace-with-a-strong-booking-db-password

# Generate a cryptographically random base64-encoded 32-byte secret.
SECURITY_JWT_SECRET=replace-with-a-random-base64-encoded-32-byte-secret

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
PASSWORD_RESET_FRONTEND_URL=http://localhost:8088
