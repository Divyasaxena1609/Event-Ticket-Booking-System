# Docker Compose reads .env from this folder. Copy this file to .env and set real secrets.
SECURITY_JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Password-reset mail; use a provider-specific app password, not your mailbox password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
PASSWORD_RESET_FRONTEND_URL=http://localhost:8088
