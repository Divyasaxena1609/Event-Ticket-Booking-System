# Optional local overrides for Docker Compose.
# The defaults in compose.yaml are intended ONLY for local development.
# Do not use these values in production. Never commit your real .env file.

AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=local-dev-auth-db-password
USER_DB_USERNAME=user_postgres
USER_DB_PASSWORD=local-dev-user-db-password
EVENT_DB_USERNAME=event_user
EVENT_DB_PASSWORD=local-dev-event-db-password
BOOKING_DB_USERNAME=booking_user
BOOKING_DB_PASSWORD=local-dev-booking-db-password

# Shared local-only 32-byte JWT key (Base64). Override with a secure random value outside local demos.
SECURITY_JWT_SECRET=bG9jYWwtZGV2LW9ubHktand0LWtleS0zMi1ieXRlcyE=

# Optional: required only to enable real Razorpay checkout/webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: required only for actual email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=
PASSWORD_RESET_FRONTEND_URL=http://localhost:8088
