# Copy this file to auth-service/.env and replace the values before starting auth-service.
# Gmail example: enable two-step verification and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=your-email@gmail.com
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173

# Must match the gateway value. Use a securely generated base64 value outside development.
SECURITY_JWT_SECRET=VGhpcy1pcy1hLWRldmVsb3BtZW50LW9ubHktMzItYnl0ZS1rZXk=
