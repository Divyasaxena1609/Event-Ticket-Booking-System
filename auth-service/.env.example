# Copy to auth-service/.env for local development; never commit real values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-provider-app-password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=your-email@example.com
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173

# Generate a unique, cryptographically random base64-encoded 32-byte secret.
SECURITY_JWT_SECRET=replace-with-a-random-base64-encoded-32-byte-secret
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=replace-with-a-strong-local-database-password
